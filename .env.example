# Copy to .env for local Docker Compose use and replace every placeholder.
MYSQL_DATABASE=marketplace
MYSQL_USER=marketplace
MYSQL_PASSWORD=REPLACE_WITH_LOCAL_DEVELOPMENT_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_LOCAL_ROOT_PASSWORD
JWT_SECRET=REPLACE_WITH_BASE64_ENCODED_SECRET_AT_LEAST_32_BYTES
SPRING_PROFILES_ACTIVE=dev
APP_DEMO_DATA_ENABLED=true
